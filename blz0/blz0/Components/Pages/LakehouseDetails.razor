@page "/lakehouses/{workspaceId}/{lakehouseId}"
@rendermode InteractiveServer
@using Models
@using Operations
@using SharedServices
@using Microsoft.Identity.Client
@using Microsoft.Identity.Web
@inject FabricApiData FabricApiData
@inject SharedFabricAuth SharedFabricAuth
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Lakehouse Details</PageTitle>
<BreadcrumbCustom />
<h3>Lakehouse Details</h3>
<button type="button" class="btn btn-outline-secondary mb-3" @onclick="GoBackAsync">Back</button>

@if (!string.IsNullOrWhiteSpace(errorText))
{
    <p class="text-danger fw-semibold">@errorText</p>
}
else if (lakehouse == null)
{
    <p>Loading...</p>
}
else
{
    <table class="table table-bordered table-striped">
        <tbody>
            <tr><th>Id</th><td>@lakehouse.Id</td></tr>
            <tr><th>Name</th><td>@lakehouse.DisplayName</td></tr>
            <tr><th>Description</th><td>@lakehouse.Description</td></tr>
            <tr><th>Type</th><td>@lakehouse.Type</td></tr>
            <tr>
                <th>Workspace Id</th>
                <td>
                    @if (!string.IsNullOrWhiteSpace(workspaceId))
                    {
                        <NavLink href="@($"/workspaces/details/{workspaceId}")">@workspaceId</NavLink>
                    }
                </td>
            </tr>
            <tr><th>Folder Id</th><td>@lakehouse.FolderId</td></tr>
            <tr><th>Default Schema</th><td>@lakehouse.DefaultSchema</td></tr>
            <tr><th>OneLake Tables Path</th><td>@lakehouse.OneLakeTablesPath</td></tr>
            <tr><th>OneLake Files Path</th><td>@lakehouse.OneLakeFilesPath</td></tr>
            <tr><th>SQL Endpoint Id</th><td>@lakehouse.SqlEndpointId</td></tr>
            <tr><th>SQL Endpoint Connection String</th><td>@lakehouse.SqlEndpointConnectionString</td></tr>
            <tr><th>SQL Endpoint Provisioning Status</th><td>@lakehouse.SqlEndpointProvisioningStatus</td></tr>
        </tbody>
    </table>

    <section class="mt-4">
        <h4>Tables</h4>
        @if (!string.IsNullOrWhiteSpace(tablesErrorText))
        {
            <p class="text-danger fw-semibold">@tablesErrorText</p>
        }
        else if (lakehouseTables == null)
        {
            <p>Loading tables...</p>
        }
        else if (lakehouseTables.Count == 0)
        {
            <p>No tables found.</p>
        }
        else
        {
            <div class="table-scroll-x">
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Type</th>
                            <th>Format</th>
                            <th>Location</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var table in lakehouseTables.OrderBy(e => e.Name))
                        {
                            <tr>
                                <td>@DisplayValue(table.Name)</td>
                                <td>@DisplayValue(table.Type)</td>
                                <td>@DisplayValue(table.Format)</td>
                                <td>@DisplayValue(table.Location)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

@code {
    [Parameter]
    public string? workspaceId { get; set; }

    [Parameter]
    public string? lakehouseId { get; set; }

    private Lakehouse? lakehouse;
    private List<LakehouseTable>? lakehouseTables;
    private string? errorText;
    private string? tablesErrorText;

    protected override async Task OnParametersSetAsync()
    {
        errorText = null;
        tablesErrorText = null;
        lakehouse = null;
        lakehouseTables = null;

        if (string.IsNullOrWhiteSpace(workspaceId) || string.IsNullOrWhiteSpace(lakehouseId))
        {
            errorText = "Missing workspace id or lakehouse id.";
            return;
        }

        try
        {
            var client = await GetFabricRestClientForDetailsAsync();
            if (client == null)
            {
                errorText = "Fabric token is not ready.";
                return;
            }

            await FabricApiData.GetLakehousesApiAsync(client, workspaceId);
            lakehouse = (FabricApiData.lakehousesList ?? [])
                .FirstOrDefault(e => string.Equals(e.Id, lakehouseId, StringComparison.OrdinalIgnoreCase));
            if (lakehouse == null)
            {
                errorText = "Lakehouse not found.";
                return;
            }

            try
            {
                var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
                if (authState.User.Identity?.IsAuthenticated != true)
                {
                    tablesErrorText = "User is not authenticated yet.";
                    return;
                }

                var lakehouseClient = await SharedFabricAuth.FabricAuth.GetFabricLakehouseApiClientAsync(authState.User);
                lakehouseTables = await FabricApiData.GetLakehouseTablesApiAsync(lakehouseClient, workspaceId, lakehouseId);
            }
            catch (Exception ex)
            {
                if (IsUiRequiredTokenException(ex))
                {
                    tablesErrorText = GetLakehouseTablesConsentMessage();
                    return;
                }

                tablesErrorText = ex.Message;
            }
        }
        catch (Exception ex)
        {
            if (IsUiRequiredTokenException(ex))
            {
                RedirectForConsent();
                return;
            }

            errorText = ex.Message;
        }
    }

    private async Task<HttpClient?> GetFabricRestClientForDetailsAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated != true)
        {
            return null;
        }

        return await SharedFabricAuth.FabricAuth.GetFabricApiClientAsync(user);
    }

    private static string DisplayValue(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "-" : value;
    }

    private async Task GoBackAsync()
    {
        await JS.InvokeVoidAsync("history.back");
    }

    private void RedirectForConsent()
    {
        errorText = "Fabric requires sign-in or consent. Redirecting...";
        var returnUrl = Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri));
        Navigation.NavigateTo($"/MicrosoftIdentity/Account/SignIn?redirectUri=/{returnUrl}", forceLoad: true);
    }

    private static string GetLakehouseTablesConsentMessage()
    {
        return "Lakehouse table listing needs consent for the Fabric Lakehouse.Read.All delegated permission. Add or approve this permission, then sign out and sign in again.";
    }

    private static bool IsUiRequiredTokenException(Exception ex)
    {
        if (ex is MicrosoftIdentityWebChallengeUserException)
        {
            return true;
        }

        if (ex is MsalUiRequiredException)
        {
            return true;
        }

        if (ex.InnerException is MsalUiRequiredException)
        {
            return true;
        }

        return ex.Message.Contains("No account or login hint was passed to the AcquireTokenSilent call", StringComparison.OrdinalIgnoreCase)
            || ex.Message.Contains("user_null", StringComparison.OrdinalIgnoreCase)
            || ex.Message.Contains("IDW10502", StringComparison.OrdinalIgnoreCase);
    }
}
