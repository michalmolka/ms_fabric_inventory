        {
            GlobalData.DatasetIdState = workspaceIdNav ?? string.Empty;
            await FabricSqlData.GetDatasetsSqlAsync(workspaceIdNav, activeFilter, null, allowedWorkspaceIds);
        }
        else
        {
            await FabricSqlData.GetDatasetsSqlAsync(workspaceIdNav, activeFilter, null, allowedWorkspaceIds);
        }
    }

