@using Data
@inject GlobalData GlobalData
@using Operations
@inject FabricApiData FabricApiData
@inject FabricSqlData FabricSqlData
@using System.Reflection
@using SharedServices
@inject SharedFabricAuth SharedFabricAuth
@using Models
@rendermode InteractiveServer
@using Microsoft.AspNetCore.SignalR.Client
@inject NavigationManager Navigation
@using BlazorBootstrap
@using System.Security.Authentication
@using blz0.Authorization
@using Microsoft.Identity.Client
@using Microsoft.Identity.Web
@implements IAsyncDisposable
@inject IWebHostEnvironment HostEnvironment
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IConfiguration Configuration


<Toasts class="p-3" Messages="messages" AutoHide="true" Delay="6000" Placement="ToastsPlacement.TopRight" />



<div class="cache-toolbar">
    <div class="cache-status">
        @CacheStatusText
    </div>
    <div class="active-filter btn-group" role="group" aria-label="Record status filter">
        <button type="button" class='@GetActiveFilterButtonClass("active")' @onclick="SetActiveFilterActiveAsync">Active</button>
        <button type="button" class='@GetActiveFilterButtonClass("inactive")' @onclick="SetActiveFilterInactiveAsync">Inactive</button>
        <button type="button" class='@GetActiveFilterButtonClass("all")' @onclick="SetActiveFilterAllAsync">All</button>
    </div>
    <button class="btn btn-warning" @onclick="RefreshDataAsync" disabled="@RefreshButtonDisabled">@RefreshButtonText</button>
    @if (StatusInfo)
    {
        <span class="spinner-border spinner-border-sm text-warning" role="status"></span>
    }
    @if (!string.IsNullOrWhiteSpace(refreshErrorText))
    {
        <span class="text-danger fw-semibold">@refreshErrorText</span>
    }
</div>

<div @key="gridRenderVersion" class="inventory-table-wrap">
    @switch (FabricObjectType)
    {
        case "capacitiesList":
            <CapacityInventoryTable Items="FabricSqlData.capacitiesList" />
            break;
        case "workspacesList":
            <WorkspaceInventoryTable Items="FabricSqlData.workspacesList" />
            break;
        case "datasetsList":
            <DatasetInventoryTable Items="FabricSqlData.datasetsList"
                                   DetailsLink="@GetDatasetDetailsLink"
                                   RefreshSummary="@RenderDatasetRefreshSummary" />
            break;
        case "reportsList":
            <ReportInventoryTable Items="FabricSqlData.reportsList"
                                  DatasetLink="@GetDatasetLink" />
            break;
        case "lakehousesList":
            <LakehouseInventoryTable Items="FabricSqlData.lakehousesList" />
            break;
        case "warehousesList":
            <WarehouseInventoryTable Items="FabricSqlData.warehousesList" />
            break;
    }
</div>

@code {
    [CascadingParameter(Name = "FabricObjectType")]
    public string? FabricObjectType { get; set; }
    [CascadingParameter(Name = "workspaceIdNav")]
    public string? workspaceIdNav { get; set; }
    [CascadingParameter(Name = "capacityIdNav")]
    public string? capacityIdNav { get; set; }
    public bool StatusInfo { get; set; }
    private HubConnection? hubConnection;
    List<ToastMessage> messages = new List<ToastMessage>();
    private bool isLoadingData;
    private bool? isPowerBiInventoryAdmin;
    private string activeFilter = "active";
    private int gridRenderVersion;
    private List<string>? cachedAccessibleCapacityIds;
    private List<string>? cachedAccessibleWorkspaceIds;
    private DateTime? cachedAccessFetchedAtUtc;
    private TimeSpan AccessCacheTtl => TimeSpan.FromMinutes(
        int.TryParse(Configuration["Authorization:UserAccessCacheTtlMinutes"], out var minutes) && minutes > 0
            ? minutes
            : 60);
    private string? refreshErrorText;
    private static readonly TimeSpan DatasetRefreshCacheTtl = TimeSpan.FromMinutes(15);
    private static readonly TimeSpan DatasetInProgressPollInterval = TimeSpan.FromSeconds(10);
    private static readonly TimeSpan DatasetInProgressMaxAge = TimeSpan.FromMinutes(5);
    private PeriodicTimer? cacheStatusTimer;
    private CancellationTokenSource? cacheStatusTimerCancellation;
    private bool pendingPowerBiTokenChallenge;
    private readonly HashSet<string> refreshingDatasetKeys = new(StringComparer.OrdinalIgnoreCase);
    private bool RefreshButtonDisabled => StatusInfo;
    private string RefreshButtonText => "Refresh from Fabric";
    private string CacheStatusText
    {
        get
        {
            if (FabricSqlData.currentCacheState?.RefreshedAtUtc == null)
            {
                return "Cache has not been refreshed yet";
            }

            var elapsed = DateTime.UtcNow - FabricSqlData.currentCacheState.RefreshedAtUtc;
            return $"Updated {FormatElapsed(elapsed)} ago | {FabricSqlData.currentCacheState.RowCount} rows";
        }
    }

    
    private void AddToastMessage(ToastType toastType)
    {
        messages.Add(new ToastMessage
            {
                Type = toastType,
                Title = "Blazor Bootstrap",
                HelpText = $"{DateTime.Now}",
                Message = $"Records have been added: {DateTime.Now}",
            });
    }

    // private ToastMessage CreateToastMessage(ToastType toastType)
    // => new ToastMessage
    //     {
    //         Type = toastType,
    //         Title = "Blazor Bootstrap",
    //         HelpText = $"{DateTime.Now}",
    //         Message = $"Records have been added: {DateTime.Now}",
    //     };

    protected override async Task OnInitializedAsync()
    {
        SharedFabricAuth.OnChange += OnSharedAuthChanged;
        cacheStatusTimerCancellation = new CancellationTokenSource();
        cacheStatusTimer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        _ = RefreshCacheStatusClockAsync(cacheStatusTimerCancellation.Token);

        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/notificationHub"), options =>
            {
                if (HostEnvironment.IsDevelopment())
                {
                    options.HttpMessageHandlerFactory = handler =>
                    {
                        if (handler is HttpClientHandler clientHandler)
                        {
                            clientHandler.ServerCertificateCustomValidationCallback = HttpClientHandler.DangerousAcceptAnyServerCertificateValidator;
                        }

                        return handler;
                    };
                }
            })
            .Build();

        hubConnection.On<string>("ReceiveNotification", async (message) =>
        {
            AddToastMessage(ToastType.Info);
            await InvokeAsync(StateHasChanged);
        });

        try
        {
            await hubConnection.StartAsync();
        }
        catch (Exception ex) when (
            ex is InvalidDataException ||
            ex is HttpRequestException ||
            ex is AuthenticationException)
        {
            // Under external auth providers in dev, hub negotiation can return HTML/login content.
            // We keep the page functional and just skip real-time toast notifications.
            await hubConnection.DisposeAsync();
            hubConnection = null;
        }
    }

    public async ValueTask DisposeAsync()
    {
        SharedFabricAuth.OnChange -= OnSharedAuthChanged;
        cacheStatusTimerCancellation?.Cancel();
        cacheStatusTimer?.Dispose();
        cacheStatusTimerCancellation?.Dispose();

        if (hubConnection != null)
        {
            await hubConnection.DisposeAsync();
        }
    }

    private async Task RefreshCacheStatusClockAsync(CancellationToken cancellationToken)
    {
        if (cacheStatusTimer == null)
        {
            return;
        }

        try
        {
            while (await cacheStatusTimer.WaitForNextTickAsync(cancellationToken))
            {
                if (FabricSqlData.currentCacheState != null)
                {
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadDataAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!pendingPowerBiTokenChallenge)
        {
            return;
        }

        pendingPowerBiTokenChallenge = false;
        var returnUrl = Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri));
        Navigation.NavigateTo($"/MicrosoftIdentity/Account/SignIn?redirectUri=/{returnUrl}", forceLoad: true);
    }

    private async Task OnSharedAuthChanged()
    {
        await InvokeAsync(async () =>
        {
            await LoadDataAsync();
            StateHasChanged();
        });
    }

    private async Task LoadDataAsync()
    {
        await LoadDataAsync(forceReload: false);
    }

    private async Task LoadDataAsync(bool forceReload)
    {
        if (isLoadingData)
        {
            return;
        }

        isLoadingData = true;

        try
        {
            switch (FabricObjectType)
            {
                case "capacitiesList":
                    await LoadCapacitiesAsync(forceReload);
                    break;
                case "workspacesList":
                    await LoadWorkspacesAsync(forceReload);
                    break;
                case "datasetsList":
                    await LoadDatasetsAsync(forceReload);
                    break;
                case "reportsList":
                    await LoadReportsAsync(forceReload);
                    break;
                case "lakehousesList":
                    await LoadLakehousesAsync(forceReload);
                    break;
                case "warehousesList":
                    await LoadWarehousesAsync(forceReload);
                    break;
                default:
                    break;
            }

            await FabricSqlData.GetCacheStateAsync(FabricObjectType ?? string.Empty, GetCurrentScopeId());
            gridRenderVersion++;
        }
        catch (Exception ex) when (IsUiRequiredTokenException(ex))
        {
            SchedulePowerBiTokenChallenge();
        }
        finally
        {
            isLoadingData = false;
        }
    }

    private async Task<HttpClient?> GetReadyFabricClientAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated != true)
        {
            return null;
        }

        await SharedFabricAuth.FabricAuth.FabricAuthAutoAsync(user);
        await SharedFabricAuth.NotifyStateChangedAsync();
        await FabricSqlData.UpsertCurrentUserMapAsync();
        return SharedFabricAuth.FabricAuth.tokenAuto;
    }

    private async Task<HttpClient?> GetReadyFabricRestClientAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated != true)
        {
            return null;
        }

        var client = await SharedFabricAuth.FabricAuth.GetFabricApiClientAsync(user);
        await FabricSqlData.UpsertCurrentUserMapAsync();
        return client;
    }

    private async Task LoadCapacitiesAsync(bool forceReload)
    {
        var allowedCapacityIds = await IsPowerBiInventoryAdminAsync()
            ? null
            : await GetAccessibleCapacityIdsAsync();
        if (forceReload || FabricSqlData.capacitiesList == null)
        {
            await FabricSqlData.GetCapacitiesSqlAsync(activeFilter, allowedCapacityIds);
        }
        else
        {
            await FabricSqlData.GetCapacitiesSqlAsync(activeFilter, allowedCapacityIds);
        }
    }

    private async Task LoadWorkspacesAsync(bool forceReload)
    {
        var allowedWorkspaceIds = await IsPowerBiInventoryAdminAsync()
            ? null
            : await GetAccessibleWorkspaceIdsAsync();
        if (forceReload || FabricSqlData.workspacesList == null || GlobalData.WorkspaceIdState != capacityIdNav)
        {
            GlobalData.WorkspaceIdState = capacityIdNav ?? string.Empty;
            await FabricSqlData.GetWorkspacesSqlAsync(capacityIdNav, activeFilter, allowedWorkspaceIds);
        }
        else
        {
            await FabricSqlData.GetWorkspacesSqlAsync(capacityIdNav, activeFilter, allowedWorkspaceIds);
        }
    }

