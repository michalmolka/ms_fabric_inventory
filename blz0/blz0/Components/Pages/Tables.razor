    private static bool IsUnsupportedFabricWorkspaceTypeException(Exception ex)
    {
        return ex.Message.Contains("WorkspaceTypeNotSupported", StringComparison.OrdinalIgnoreCase);
    }

    private string? GetCurrentScopeId()
    {
        return FabricObjectType switch
        {
            "workspacesList" => capacityIdNav,
            "datasetsList" => workspaceIdNav,
            "reportsList" => workspaceIdNav,
            "lakehousesList" => workspaceIdNav,
            "warehousesList" => workspaceIdNav,
            _ => null
        };
    }

    private static string FormatElapsed(TimeSpan elapsed)
    {
        if (elapsed.TotalSeconds < 60)
        {
            return $"{Math.Max(1, (int)elapsed.TotalSeconds)} sec";
        }

        if (elapsed.TotalMinutes < 60)
        {
            return $"{(int)elapsed.TotalMinutes} min";
        }

        if (elapsed.TotalHours < 24)
        {
            return $"{(int)elapsed.TotalHours} h";
        }

        return $"{(int)elapsed.TotalDays} d";
    }

    private async Task RefreshDataset(string datasetId)
    {
        Console.WriteLine($"RefreshDataset: {datasetId}");

        var client = await GetReadyFabricClientAsync();
        if (client == null)
        {
            return;
        }

        var workspaceId = workspaceIdNav;
        if (string.IsNullOrWhiteSpace(workspaceId))
        {
            workspaceId = FabricSqlData.datasetsList?.FirstOrDefault(e => e.Id == datasetId)?.WorkspaceId;
        }

        var refreshKey = GetDatasetRefreshKey(datasetId, workspaceId);
        if (!refreshingDatasetKeys.Add(refreshKey))
        {
            return;
        }

        StateHasChanged();

        try
        {
            await FabricApiData.RefreshDatasetAsync(client, datasetId, workspaceId);
            await FabricSqlData.UpdateDatasetRefreshCacheAsync(datasetId, workspaceId, DateTime.UtcNow, "InProgress");
            var refreshed = FabricSqlData.datasetsList?.FirstOrDefault(e => e.Id == datasetId && e.WorkspaceId == workspaceId);
            if (refreshed != null)
            {
                refreshed.LastRefreshAtUtc = DateTime.UtcNow;
                refreshed.LastRefreshStatus = "InProgress";
                refreshed.LastRefreshCacheUpdatedAtUtc = DateTime.UtcNow;
            }

            _ = MonitorDatasetRefreshStatusAsync(datasetId, workspaceId, client, refreshKey);
        }
        catch
        {
            refreshingDatasetKeys.Remove(refreshKey);
            await InvokeAsync(StateHasChanged);
            throw;
        }
    }

    private async Task MonitorDatasetRefreshStatusAsync(string datasetId, string? workspaceId, HttpClient client, string refreshKey)
    {
        // Keep polling after manual refresh until status leaves InProgress or timeout is reached.
        var startedAtUtc = DateTime.UtcNow;
        try
        {
            while (DateTime.UtcNow - startedAtUtc < DatasetInProgressMaxAge)
            {
                await Task.Delay(DatasetInProgressPollInterval);
                try
                {
                    var latest = await FabricApiData.GetDatasetLastRefreshAsync(client, datasetId, workspaceId);
                    await FabricSqlData.UpdateDatasetRefreshCacheAsync(datasetId, workspaceId, latest?.EndTime, latest?.Status);

                    var local = FabricSqlData.datasetsList?.FirstOrDefault(e => e.Id == datasetId && e.WorkspaceId == workspaceId);
                    if (local != null)
                    {
                        local.LastRefreshAtUtc = latest?.EndTime;
                        local.LastRefreshStatus = latest?.Status;
                        local.LastRefreshCacheUpdatedAtUtc = DateTime.UtcNow;
                    }

                    await InvokeAsync(StateHasChanged);

                    if (!string.Equals(latest?.Status, "InProgress", StringComparison.OrdinalIgnoreCase))
                    {
                        return;
                    }
                }
                catch
                {
                    // Keep trying until max age to avoid transient API issues.
                }
            }
        }
        finally
        {
            refreshingDatasetKeys.Remove(refreshKey);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadDatasetRefreshInfoAsync(
        IEnumerable<string>? allowedDatasetIds = null,
        IEnumerable<string>? allowedWorkspaceIds = null)
    {
        if (FabricObjectType != "datasetsList")
        {
            return;
        }

        var client = await GetReadyFabricClientAsync();
        var datasets = await FabricSqlData.GetDatasetsForRefreshCacheAsync(workspaceIdNav, activeFilter, allowedDatasetIds, allowedWorkspaceIds);
        if (client == null || datasets.Count == 0)
        {
            return;
        }

        foreach (var dataset in datasets)
        {
            if (string.IsNullOrWhiteSpace(dataset.Id))
            {
                continue;
            }

            try
            {
                var workspaceId = workspaceIdNav;
                if (string.IsNullOrWhiteSpace(workspaceId))
                {
                    workspaceId = dataset.WorkspaceId;
                }

                var isStale = dataset.LastRefreshCacheUpdatedAtUtc == null
                    || DateTime.UtcNow - dataset.LastRefreshCacheUpdatedAtUtc.Value > DatasetRefreshCacheTtl;
                var isInProgressAndAged = string.Equals(dataset.LastRefreshStatus, "InProgress", StringComparison.OrdinalIgnoreCase)
                    && dataset.LastRefreshCacheUpdatedAtUtc != null
                    && DateTime.UtcNow - dataset.LastRefreshCacheUpdatedAtUtc.Value > DatasetInProgressPollInterval;
                if (!isStale)
                {
                    if (!isInProgressAndAged)
                    {
                        continue;
                    }
                }

                var lastRefresh = await FabricApiData.GetDatasetLastRefreshAsync(client, dataset.Id, workspaceId);
                await FabricSqlData.UpdateDatasetRefreshCacheAsync(dataset.Id, workspaceId, lastRefresh?.EndTime, lastRefresh?.Status);
            }
            catch
            {
                // Keep previous cached value on transient REST/API failures.
            }
        }

        await FabricSqlData.GetDatasetsSqlAsync(workspaceIdNav, activeFilter, allowedDatasetIds, allowedWorkspaceIds);
    }

    private async Task<List<string>> GetAccessibleCapacityIdsAsync()
    {
        if (await IsPowerBiInventoryAdminAsync())
        {
            return [];
        }

        if (TryGetAccessCache(out _) && cachedAccessibleCapacityIds != null)
        {
            return cachedAccessibleCapacityIds;
        }

        var userKey = await GetCurrentUserKeyAsync();
        if (userKey == null)
        {
            return [];
        }

        var cached = await FabricSqlData.GetValidUserAccessObjectIdsAsync(userKey.Value.UserKey, "capacity", AccessCacheTtl);
        if (cached != null)
        {
            cachedAccessibleCapacityIds = cached;
            cachedAccessFetchedAtUtc = DateTime.UtcNow;
            return cachedAccessibleCapacityIds;
        }

        await RefreshUserAccessCacheFromPowerBiAsync(userKey.Value.UserKey, userKey.Value.UserName);
        return cachedAccessibleCapacityIds ?? [];
    }

    private async Task RefreshUserAccessCacheFromPowerBiAsync(string userKey, string? userName)
    {
        var client = await GetReadyFabricClientAsync();
        if (client == null)
        {
            cachedAccessibleCapacityIds = [];
            cachedAccessibleWorkspaceIds = [];
            cachedAccessFetchedAtUtc = DateTime.UtcNow;
            return;
        }

        await FabricApiData.GetCapacitiesApiAsync(client);
        await FabricApiData.GetWorkspacesApiAsync(client, capacityIdNav);

        var capacityIds = (FabricApiData.capacitiesList ?? [])
            .Select(e => e.Id)
            .Where(e => !string.IsNullOrWhiteSpace(e))
            .Cast<string>()
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        var workspaceIds = (FabricApiData.workspacesList ?? [])
            .Select(e => e.Id)
            .Where(e => !string.IsNullOrWhiteSpace(e))
            .Cast<string>()
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        await FabricSqlData.ReplaceUserAccessCacheAsync(userKey, userName, capacityIds, workspaceIds, capacityIdNav);

        cachedAccessibleCapacityIds = capacityIds;
        cachedAccessibleWorkspaceIds = workspaceIds;
        cachedAccessFetchedAtUtc = DateTime.UtcNow;
    }

    private async Task<bool> IsPowerBiInventoryAdminAsync()
    {
        if (isPowerBiInventoryAdmin.HasValue)
        {
            return isPowerBiInventoryAdmin.Value;
        }

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated != true)
        {
            isPowerBiInventoryAdmin = false;
            return false;
        }

        isPowerBiInventoryAdmin = await AdminAccessEvaluator.IsPowerBiInventoryAdminAsync(user, Configuration);
        return isPowerBiInventoryAdmin.Value;
    }

    private async Task<List<string>> GetAccessibleWorkspaceIdsAsync()
    {
        if (await IsPowerBiInventoryAdminAsync())
        {
            return await FabricSqlData.GetActiveWorkspaceIdsAsync();
        }

        if (TryGetAccessCache(out _) && cachedAccessibleWorkspaceIds != null)
        {
            return cachedAccessibleWorkspaceIds;
        }

        var userKey = await GetCurrentUserKeyAsync();
        if (userKey == null)
        {
            return [];
        }

        var cached = await FabricSqlData.GetValidUserAccessObjectIdsAsync(userKey.Value.UserKey, "workspace", AccessCacheTtl, capacityIdNav);
        if (cached != null)
        {
            cachedAccessibleWorkspaceIds = cached;
            cachedAccessFetchedAtUtc = DateTime.UtcNow;
            return cachedAccessibleWorkspaceIds;
        }

        await RefreshUserAccessCacheFromPowerBiAsync(userKey.Value.UserKey, userKey.Value.UserName);
        return cachedAccessibleWorkspaceIds ?? [];
    }

    private async Task<(string UserKey, string? UserName)?> GetCurrentUserKeyAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated != true)
        {
            return null;
        }

        var userName = user.Identity?.Name;
        var objectId = user.FindFirst("oid")?.Value
            ?? user.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value;
        var userKey = !string.IsNullOrWhiteSpace(userName)
            ? userName.Trim().ToLowerInvariant()
            : objectId?.Trim().ToLowerInvariant();

        return string.IsNullOrWhiteSpace(userKey)
            ? null
            : (userKey, userName);
    }

    private bool TryGetAccessCache(out DateTime fetchedAtUtc)
    {
        fetchedAtUtc = cachedAccessFetchedAtUtc ?? DateTime.MinValue;
        if (cachedAccessFetchedAtUtc == null)
        {
            return false;
        }

        return DateTime.UtcNow - cachedAccessFetchedAtUtc.Value < AccessCacheTtl;
    }

    private void InvalidateAccessCache()
    {
        cachedAccessibleCapacityIds = null;
        cachedAccessibleWorkspaceIds = null;
        cachedAccessFetchedAtUtc = null;
    }

    private void SchedulePowerBiTokenChallenge()
    {
        refreshErrorText = "Fabric/Power BI requires sign-in or consent. Redirecting...";
        pendingPowerBiTokenChallenge = true;
    }

    private static bool IsUiRequiredTokenException(Exception ex)
    {
        if (ex is MicrosoftIdentityWebChallengeUserException)
        {
            return true;
        }

        if (ex is MsalUiRequiredException)
        {
            return true;
        }

        if (ex.InnerException is MsalUiRequiredException)
        {
            return true;
        }

        return ex.Message.Contains("No account or login hint was passed to the AcquireTokenSilent call", StringComparison.OrdinalIgnoreCase)
            || ex.Message.Contains("user_null", StringComparison.OrdinalIgnoreCase)
            || ex.Message.Contains("IDW10502", StringComparison.OrdinalIgnoreCase);
    }


    private string GetDatasetLastRefreshText(Dataset dataset)
    {
        if (string.IsNullOrWhiteSpace(dataset.Id))
        {
            return "-";
        }

        if (dataset.LastRefreshAtUtc == null)
        {
            return "-";
        }

        return dataset.LastRefreshAtUtc.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss");
    }

    private string GetDatasetLastRefreshStatusText(Dataset dataset)
    {
        if (string.IsNullOrWhiteSpace(dataset.Id))
        {
            return "-";
        }

        if (string.IsNullOrWhiteSpace(dataset.LastRefreshStatus))
        {
            return "-";
        }

        return dataset.LastRefreshStatus;
    }

    private string GetDatasetRefreshSummaryText(Dataset dataset)
    {
        var statusText = GetDatasetLastRefreshStatusText(dataset);
        var refreshText = GetDatasetLastRefreshText(dataset);

        if (statusText == "-" && refreshText == "-")
        {
            return "No history";
        }

        return $"{statusText} ({refreshText})";
    }

    private RenderFragment RenderDatasetRefreshSummary(Dataset dataset) => @<div class="dataset-refresh-summary">
        @if (!string.IsNullOrWhiteSpace(dataset.Id))
        {
            var isRefreshing = IsDatasetRefreshing(dataset);
            <Button Color="ButtonColor.Warning"
                    Size="ButtonSize.Small"
                    @onclick="(() => RefreshDataset(dataset.Id))"
                    title="Refresh dataset"
                    class="icon-only-btn"
                    Disabled="@isRefreshing">
                @if (isRefreshing)
                {
                    <span class="spinner-border spinner-border-sm dataset-refresh-spinner" role="status" aria-hidden="true"></span>
                }
                else
                {
                    <i class="bi bi-arrow-clockwise"></i>
                }
            </Button>
        }
        <span class="dataset-refresh-text">@GetDatasetRefreshSummaryText(dataset)</span>
    </div>;

    private bool IsDatasetRefreshing(Dataset dataset)
    {
        if (string.IsNullOrWhiteSpace(dataset.Id))
        {
            return false;
        }

        return refreshingDatasetKeys.Contains(GetDatasetRefreshKey(dataset.Id, ResolveDatasetWorkspaceId(dataset)));
    }

    private string GetDatasetRefreshKey(string datasetId, string? workspaceId)
    {
        return $"{workspaceId ?? "all"}:{datasetId}";
    }

    private string? ResolveDatasetWorkspaceId(Dataset dataset)
    {
        return string.IsNullOrWhiteSpace(workspaceIdNav) ? dataset.WorkspaceId : workspaceIdNav;
    }

    private string GetDatasetDetailsLink(Dataset dataset)
    {
        var resolvedWorkspaceId = ResolveDatasetWorkspaceId(dataset);

        if (!string.IsNullOrWhiteSpace(resolvedWorkspaceId) && !string.IsNullOrWhiteSpace(dataset.Id))
        {
            return $"/datasets/{resolvedWorkspaceId}/{dataset.Id}";
        }

        return "/datasets";
    }

    private string GetDatasetLink(Report report)
    {
        if (!string.IsNullOrWhiteSpace(report.DatasetWorkspaceId) && !string.IsNullOrWhiteSpace(report.DatasetId))
        {
            return $"/datasets/{report.DatasetWorkspaceId}/{report.DatasetId}";
        }

        if (!string.IsNullOrWhiteSpace(report.WorkspaceId) && !string.IsNullOrWhiteSpace(report.DatasetId))
        {
            return $"/datasets/{report.WorkspaceId}/{report.DatasetId}";
        }

        return "/datasets";
    }

}
