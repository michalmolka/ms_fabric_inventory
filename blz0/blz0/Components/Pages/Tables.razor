    private async Task SetActiveFilterAsync(string filter)
    {
        if (activeFilter == filter)
        {
            return;
        }

        activeFilter = filter;
        await LoadDataAsync(forceReload: true);
        gridRenderVersion++;
        StateHasChanged();
    }

    private Task SetActiveFilterActiveAsync() => SetActiveFilterAsync("active");

    private Task SetActiveFilterInactiveAsync() => SetActiveFilterAsync("inactive");

    private Task SetActiveFilterAllAsync() => SetActiveFilterAsync("all");

    private string GetActiveFilterButtonClass(string filter)
    {
        return activeFilter == filter ? "btn btn-warning active" : "btn btn-outline-secondary";
    }

    public async Task RefreshDataAsync()
    {
        StatusInfo = true;
        refreshErrorText = null;
        StateHasChanged();

        try
        {
            await RefreshFromFabricAsync();
        }
        catch (Exception ex) when (IsUiRequiredTokenException(ex))
        {
            SchedulePowerBiTokenChallenge();
        }
        catch (Exception ex)
        {
            refreshErrorText = ex.Message;
        }
        finally
        {
            StatusInfo = false;
            gridRenderVersion++;
            StateHasChanged();
        }
    }

    private async Task RefreshFromFabricAsync()
    {
        InvalidateAccessCache();
        if (FabricObjectType == "lakehousesList")
        {
            await RefreshLakehousesFromFabricAsync();
        }
        else if (FabricObjectType == "warehousesList")
        {
            await RefreshWarehousesFromFabricAsync();
        }
        else
        {
            var fabricClient = await GetReadyFabricClientAsync();
            if (fabricClient == null)
            {
                return;
            }

            switch (FabricObjectType)
            {
                case "workspacesList":
                    await FabricApiData.GetWorkspacesApiAsync(fabricClient, capacityIdNav);
                    await FabricSqlData.AddWorkspaceToSqlAsync(FabricApiData.workspacesList ?? [], capacityIdNav);
                    break;
                case "datasetsList":
                    await RefreshDatasetsFromFabricAsync(fabricClient);
                    break;
                case "capacitiesList":
                    await FabricApiData.GetCapacitiesApiAsync(fabricClient);
                    await FabricSqlData.AddCapacityToSqlAsync(FabricApiData.capacitiesList ?? []);
                    break;
                case "reportsList":
                    await RefreshReportsFromFabricAsync(fabricClient);
                    break;
                default:
                    break;
            }
        }

        await LoadDataAsync(forceReload: true);
    }

    private async Task RefreshDatasetsFromFabricAsync(HttpClient fabricClient)
    {
        if (!string.IsNullOrWhiteSpace(workspaceIdNav))
        {
            await FabricApiData.GetDatasetsApiAsync(fabricClient, workspaceIdNav);
            await FabricSqlData.AddDatasetToSqlAsync(FabricApiData.datasetsList ?? [], workspaceIdNav);
            return;
        }

        var workspaceIds = await GetAccessibleWorkspaceIdsAsync();
        var totalRows = 0;

        foreach (var workspaceId in workspaceIds)
        {
            await FabricApiData.GetDatasetsApiAsync(fabricClient, workspaceId);
            var datasets = (FabricApiData.datasetsList ?? []).ToList();
            totalRows += datasets.Count;
            await FabricSqlData.AddDatasetToSqlAsync(datasets, workspaceId, notify: false);
        }

        await FabricSqlData.SetCacheRefreshedAsync("datasetsList", null, totalRows);
        await FabricSqlData.SendRefreshNotificationAsync("Datasets cache refreshed.");
    }

    private async Task RefreshReportsFromFabricAsync(HttpClient fabricClient)
    {
        if (!string.IsNullOrWhiteSpace(workspaceIdNav))
        {
            await FabricApiData.GetReportsApiAsync(fabricClient, workspaceIdNav);
            await FabricSqlData.AddReportToSqlAsync(FabricApiData.reportsList ?? [], workspaceIdNav);
