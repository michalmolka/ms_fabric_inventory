    private async Task<List<Lakehouse>> TryGetLakehousesForWorkspaceAsync(HttpClient fabricRestClient, string workspaceId)
    {
        try
        {
            await FabricApiData.GetLakehousesApiAsync(fabricRestClient, workspaceId);
            return (FabricApiData.lakehousesList ?? []).ToList();
        }
        catch (Exception ex) when (IsUnsupportedFabricWorkspaceTypeException(ex))
        {
            return [];
        }
    }

