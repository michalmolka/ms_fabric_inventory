@page "/workspaces/details/{workspaceId}"
@rendermode InteractiveServer
@using Models
@using Operations
@using SharedServices
@using blz0.Authorization
@inject FabricApiData FabricApiData
@inject SharedFabricAuth SharedFabricAuth
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IConfiguration Configuration
@inject IJSRuntime JS

<PageTitle>Workspace Details</PageTitle>
<BreadcrumbCustom />
<h3>Workspace Details</h3>
<button type="button" class="btn btn-outline-secondary mb-3" @onclick="GoBackAsync">Back</button>

@if (!string.IsNullOrWhiteSpace(errorText))
{
    <p class="text-danger fw-semibold">@errorText</p>
}
else if (workspace == null)
{
    <p>Loading...</p>
}
else
{
    <table class="table table-bordered table-striped">
        <tbody>
            <tr><th>Id</th><td>@workspace.Id</td></tr>
            <tr><th>Name</th><td>@workspace.Name</td></tr>
            <tr><th>Type</th><td>@workspace.Type</td></tr>
            <tr><th>Capacity Id</th><td>@workspace.CapacityId</td></tr>
            <tr><th>Read Only</th><td>@workspace.IsReadOnly</td></tr>
            <tr><th>Dedicated Capacity</th><td>@workspace.IsOnDedicatedCapacity</td></tr>
            <tr><th>Default Storage Format</th><td>@workspace.DefaultDatasetStorageFormat</td></tr>
        </tbody>
    </table>
}

@code {
    [Parameter]
    public string? workspaceId { get; set; }

    private Workspace? workspace;
    private string? errorText;

    protected override async Task OnParametersSetAsync()
    {
        errorText = null;
        workspace = null;

        if (string.IsNullOrWhiteSpace(workspaceId))
        {
            errorText = "Missing workspace id.";
            return;
        }

        try
        {
            var clients = await GetFabricClientsForDetailsAsync();
            if (clients.Count == 0)
            {
                errorText = "Power BI token is not ready.";
                return;
            }

            Exception? lastException = null;
            foreach (var client in clients)
            {
                try
                {
                    workspace = await FabricApiData.GetWorkspaceByIdAsync(client, workspaceId);
                    if (workspace == null)
                    {
                        errorText = "Workspace not found.";
                    }

                    return;
                }
                catch (Exception ex) when (ShouldTryFallback(ex))
                {
                    lastException = ex;
                }
            }

            if (lastException != null)
            {
                throw lastException;
            }
        }
        catch (Exception ex)
        {
            errorText = ex.Message;
        }
    }

    private async Task<List<HttpClient>> GetFabricClientsForDetailsAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated != true)
        {
            return [];
        }

        var clients = new List<HttpClient>();
        var delegatedClient = SharedFabricAuth.IsTokenReady ? SharedFabricAuth.FabricAuth.tokenAuto : null;

        if (delegatedClient != null)
        {
            clients.Add(delegatedClient);
        }

        return clients;
    }

    private static bool ShouldTryFallback(Exception ex)
    {
        return ex is InvalidOperationException
            && (ex.Message.Contains("401", StringComparison.OrdinalIgnoreCase)
                || ex.Message.Contains("403", StringComparison.OrdinalIgnoreCase)
                || ex.Message.Contains("500", StringComparison.OrdinalIgnoreCase));
    }

    private async Task GoBackAsync()
    {
        await JS.InvokeVoidAsync("history.back");
    }
}
