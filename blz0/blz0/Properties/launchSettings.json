{
  "$schema": "https://json.schemastore.org/launchsettings.json",
    "profiles": {
      "http": {
        "commandName": "Project",
        "dotnetRunMessages": true,
        "launchBrowser": true,
        "inspectUri": "{wsProtocol}://{url.hostname}:{url.port}/_framework/debug/ws-proxy?browser={browserInspectUri}",
        "applicationUrl": "http://localhost:5172",
        "environmentVariables": {
          "ASPNETCORE_ENVIRONMENT": "Development",
          "ASPNETCORE_Kestrel__Certificates__Default__Path": "/home/vscode/.aspnet/https/blz0-dev.pfx",
          "ASPNETCORE_Kestrel__Certificates__Default__Password": "blz0-dev-pass"
        }
      },
      "https": {
        "commandName": "Project",
        "dotnetRunMessages": true,
        "launchBrowser": true,
        "inspectUri": "{wsProtocol}://{url.hostname}:{url.port}/_framework/debug/ws-proxy?browser={browserInspectUri}",
        "applicationUrl": "https://localhost:7040;http://localhost:5172",
        "environmentVariables": {
          "ASPNETCORE_ENVIRONMENT": "Development",
          "ASPNETCORE_Kestrel__Certificates__Default__Path": "/home/vscode/.aspnet/https/blz0-dev.pfx",
          "ASPNETCORE_Kestrel__Certificates__Default__Password": "blz0-dev-pass"
        }
      }
    }
  }
